    private static Task SlowSave() => Task.Delay(1200);

    private async Task Confirm()
    {
        if (await Dialogs.ConfirmAsync(CnLabels.Save, CnLabels.Amount))
            Toasts.Success(CnLabels.Save);
        else
            Toasts.Information(CnLabels.Cancel);
    }

    private async Task ConfirmDelete()
    {
        if (await Dialogs.ConfirmAsync(CnLabels.Clear, CnLabels.Amount, destructive: true))
            Toasts.Success(CnLabels.Clear);
    }

    private async Task OpenDialog()
    {
        if (await Dialogs.ShowAsync<SampleDialog, bool>(CnLabels.NewItem, width: "480px"))
            Toasts.Success(CnLabels.Save);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            StateHasChanged();
        }
    }
