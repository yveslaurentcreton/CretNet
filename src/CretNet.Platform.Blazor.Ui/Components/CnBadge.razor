@* Lifted from HCMT.WasmApp/Ui verbatim (WAM S-142): small status pill,
   styled by .cn-badge / .cn-badge--accent in cn-ui.css. *@

<span class="cn-badge @(Accent ? "cn-badge--accent" : null) @Class" style="@Style">@ChildContent</span>

@code {
    [Parameter] public bool Accent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
}
