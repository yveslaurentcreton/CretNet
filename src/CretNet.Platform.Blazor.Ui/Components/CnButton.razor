@using Microsoft.AspNetCore.Components.Web
@using SmartFormat

<button type="@(Submit ? "submit" : "button")"
        class="cn-btn @RoleClass @(IconOnly ? "cn-btn--icononly" : null) @(Dashed ? "cn-btn--dashed" : null) @Class"
        style="@Style"
        title="@FormattedTitle"
        aria-label="@(FormattedTitle ?? FormattedLabel)"
        disabled="@(Disabled || IsLoading)"
        @onclick="HandleClick">
    @if (Icon is not null)
    {
        <CnIcon Kind="Icon.Value"/>
    }
    @if (UseLabel)
    {
        <span>@FormattedLabel</span>
    }
    @ChildContent
    @if (IconEnd is not null)
    {
        <CnIcon Kind="IconEnd.Value"/>
    }
</button>

@code {
    // Busy labels follow the CretNet convention: "{0:Saving|Save}" formatted
    // with the loading flag. Async OnClick handlers set the flag themselves.
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public CnIconKind? Icon { get; set; }
    [Parameter] public CnIconKind? IconEnd { get; set; }
    [Parameter] public CnButtonRole Role { get; set; } = CnButtonRole.Neutral;
    [Parameter] public bool Submit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Dashed { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private bool _busy;

    private bool IsLoading => Loading || _busy;

    // Title goes through the same busy-label convention as Label
    // ("{0:Editing|Edit}") — icon-only buttons pass CnpLabels values as
    // tooltips, which would otherwise render the raw template.
    private string? FormattedTitle => Title is null ? null : Smart.Format(Title, IsLoading);
    private string? FormattedLabel => Label is null ? null : Smart.Format(Label, IsLoading);
    private bool UseLabel => !string.IsNullOrEmpty(Label);
    private bool IconOnly => !UseLabel && ChildContent is null;

    private string RoleClass => Role switch
    {
        CnButtonRole.Accent => "cn-btn--accent",
        CnButtonRole.Subtle => "cn-btn--subtle",
        CnButtonRole.Danger => "cn-btn--danger",
        _ => "cn-btn--neutral",
    };

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Submit || !OnClick.HasDelegate || IsLoading)
            return;

        _busy = true;
        try
        {
            await OnClick.InvokeAsync(args);
        }
        finally
        {
            _busy = false;
        }
    }
}
