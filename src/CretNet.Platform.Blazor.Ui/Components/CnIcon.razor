<svg class="cn-icon @AppearanceClass @ToneClass @Class" data-icon-role="@EffectiveRole.ToString().ToLowerInvariant()" style="@Style" viewBox="@ViewBox" aria-hidden="true" focusable="false">@Content</svg>

@code {
    [Parameter, EditorRequired] public CnIconKind Kind { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public CnIconAppearance? Appearance { get; set; }
    /// <summary>Defaults to Action; entity/navigation composition chooses Entity explicitly.</summary>
    [Parameter] public CnIconRole? Role { get; set; }
    [CascadingParameter] private CnIconAppearance? InheritedAppearance { get; set; }
    [CascadingParameter] private CnActionIconAppearance? ActionAppearance { get; set; }
    [CascadingParameter] private CnIconRole? InheritedRole { get; set; }
    [CascadingParameter(Name = "CnButtonIconAppearance")] private CnIconAppearance? ButtonAppearance { get; set; }

    private static readonly CnIconAppearance Outline = new();
    private static long _sequence;
    private readonly string _prefix = "cn-icon-" + System.Threading.Interlocked.Increment(ref _sequence);
    private CnIconKind? _renderedKind;
    private CnIconStyle? _renderedStyle;
    private MarkupString _artwork;
    private CnIconRole EffectiveRole => Role ?? InheritedRole ?? CnIconRole.Action;
    private bool UsesActionAppearance => Appearance is null && ButtonAppearance is null
        && EffectiveRole == CnIconRole.Action && ActionAppearance is not null;
    private CnIconAppearance EffectiveAppearance => Appearance ?? ButtonAppearance
        ?? (UsesActionAppearance ? ActionAppearance!.For(Kind) : InheritedAppearance) ?? Outline;
    private string? ToneClass => UsesActionAppearance && ActionAppearance!.Tone(Kind) is { } tone
        ? $"cn-icon--{tone}" : null;
    private CnIconFamily Family => EffectiveAppearance.Style.Family();
    // Outline keeps its 16-unit grid, the artwork 48 and the drawn styles (Porcelain, Line) 24.
    private string ViewBox => Family switch
    {
        CnIconFamily.Outline => "0 0 16 16",
        CnIconFamily.Natural => "0 0 48 48",
        _ => "0 0 24 24",
    };
    // Natural keeps its historical cn-icon--natural/--category classes; the drawn
    // families add cn-icon--by-category for their category colour mode.
    private string AppearanceClass => Family switch
    {
        CnIconFamily.Outline => string.Empty,
        CnIconFamily.Natural => $"cn-icon--{EffectiveAppearance.Style.ToString().ToLowerInvariant()}{ModifierClasses}",
        _ => $"cn-icon--{Family.ToString().ToLowerInvariant()}{(EffectiveAppearance.Style.ColorMode() == CnIconColorMode.Category ? " cn-icon--by-category" : null)}{ModifierClasses}",
    };
    private string ModifierClasses => (EffectiveAppearance.Intensity == CnIconIntensity.Quiet ? " cn-icon--quiet" : null)
        + (!EffectiveAppearance.Depth ? " cn-icon--flat" : null);
    private MarkupString Content => EffectiveAppearance.Style == CnIconStyle.Outline ? OutlineContent : _artwork;

    protected override void OnParametersSet()
    {
        if (_renderedKind == Kind && _renderedStyle == EffectiveAppearance.Style) return;
        _renderedKind = Kind;
        _renderedStyle = EffectiveAppearance.Style;
        if (EffectiveAppearance.Style == CnIconStyle.Outline)
        {
            _artwork = default;
            return;
        }
        var svg = EffectiveAppearance.Style switch
        {
            CnIconStyle.Category => CnIconArtwork.Category(Kind),
            CnIconStyle.Natural => CnIconArtwork.Natural(Kind),
            var drawn => CnIconArtwork.Drawn(Kind, drawn),
        };
        _artwork = new(svg.Replace("__CN_ICON__", _prefix, StringComparison.Ordinal));
    }

    private CnIconKind OutlineKind => Kind switch
    {
        CnIconKind.DocumentSpark => CnIconKind.DocumentStack,
        CnIconKind.DocumentTag => CnIconKind.Document,
        CnIconKind.DocumentFlow => CnIconKind.DocumentStack,
        CnIconKind.ClipboardArrowRight => CnIconKind.Document,
        CnIconKind.Truck => CnIconKind.Box,
        CnIconKind.InvoiceArrowRight => CnIconKind.Document,
        CnIconKind.ClipboardArrowLeft => CnIconKind.Document,
        CnIconKind.BoxCheck => CnIconKind.Box,
        CnIconKind.InvoiceArrowLeft => CnIconKind.Document,
        CnIconKind.Inbox => CnIconKind.DocumentStack,
        CnIconKind.LinkedBlocks => CnIconKind.Settings,
        CnIconKind.BoxLabel => CnIconKind.Box,
        CnIconKind.Boxes => CnIconKind.Box,
        CnIconKind.BoxChecklist => CnIconKind.Checkmark,
        CnIconKind.Wrench => CnIconKind.Coins,
        CnIconKind.FolderPlan => CnIconKind.Briefcase,
        CnIconKind.TaskBoard => CnIconKind.TaskCheck,
        CnIconKind.CalendarClock => CnIconKind.Calculator,
        CnIconKind.Wallet => CnIconKind.Briefcase,
        CnIconKind.CreditCard => CnIconKind.Coins,
        CnIconKind.Transfer => CnIconKind.SwapArrows,
        CnIconKind.DocumentMatch => CnIconKind.TaskCheck,
        CnIconKind.IdBadge => CnIconKind.People,
        CnIconKind.LedgerExport => CnIconKind.ArrowDownload,
        _ => Kind,
    };

