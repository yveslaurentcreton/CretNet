@using CretNet.Platform.Blazor.Ui.Resources

<div class="cn-icon-settings">
    @if (ActionValue is not null)
    {
        <h3 class="cn-icon-settings-heading">@CnLabels.IconEntities</h3>
    }
    @* Two axes: the drawing (Natural, Porcelain, Line) and its colouring (own or per category). *@
    <div class="cn-icon-settings-label">@CnLabels.IconStyle</div>
    <div class="cn-icon-choices cn-icon-choices--compact" role="group" aria-label="@CnLabels.IconStyle">
        @foreach (var family in Families)
        {
            var style = Selected.WithFamily(family);
            <button type="button" aria-pressed="@Pressed(Selected.Family() == family)"
                    @onclick="() => Change(Value with { Style = style })">
                <CnIcon Kind="CnIconKind.DocumentSpark" Appearance="@(Value with { Style = style })" Style="width:18px;height:18px" />
                @FamilyLabel(family)
            </button>
        }
    </div>
    <div class="cn-icon-settings-label">@CnLabels.IconColorMode</div>
    <div class="cn-icon-choices cn-icon-choices--compact" role="group" aria-label="@CnLabels.IconColorMode">
        @foreach (var color in Enum.GetValues<CnIconColorMode>())
        {
            var style = Selected.WithColorMode(color);
            <button type="button" aria-pressed="@Pressed(Selected.ColorMode() == color)"
                    @onclick="() => Change(Value with { Style = style })">
                <CnIcon Kind="CnIconKind.DocumentSpark" Appearance="@(Value with { Style = style })" Style="width:18px;height:18px" />
                @(color == CnIconColorMode.Own ? CnLabels.IconOwnColors : CnLabels.IconCategoryColors)
            </button>
        }
    </div>
    <div class="cn-icon-settings-label">@CnLabels.IconColorIntensity</div>
    <div class="cn-icon-choices" role="group" aria-label="@CnLabels.IconColorIntensity">
        @foreach (var intensity in Enum.GetValues<CnIconIntensity>())
        {
            <button type="button" aria-pressed="@Pressed(Value.Intensity == intensity)"
                    @onclick="() => Change(Value with { Intensity = intensity })">
                @(intensity == CnIconIntensity.Normal ? CnLabels.IconNormalIntensity : CnLabels.IconQuietIntensity)
            </button>
        }
    </div>
    <div class="cn-icon-settings-label">@CnLabels.IconNavigationSize</div>
    <div class="cn-icon-choices" role="group" aria-label="@CnLabels.IconNavigationSize">
        @foreach (var size in Enum.GetValues<CnNavigationIconSize>())
        {
            <button type="button" aria-pressed="@Pressed(Value.NavigationSize == size)"
                    @onclick="() => Change(Value with { NavigationSize = size })">
                <CnIcon Kind="CnIconKind.FolderPlan" Appearance="Value" Style="@($"width:{(int)size}px;height:{(int)size}px")" />
                @((int)size) px
            </button>
        }
    </div>
    <CnCheckbox Value="@(Selected.SupportsDepth() && Value.Depth)" Disabled="@(!Selected.SupportsDepth())"
                ValueChanged="depth => Change(Value with { Depth = depth })" Label="@CnLabels.IconSubtleDepth" />
    @if (ActionValue is { } actions)
    {
        <h3 class="cn-icon-settings-heading cn-icon-settings-heading--actions">@CnLabels.IconActions</h3>
        <div class="cn-icon-choices cn-icon-action-choices" role="group" aria-label="@CnLabels.IconActionStyle">
            @foreach (var style in Enum.GetValues<CnActionIconStyle>())
            {
                var preview = actions.Style == style ? actions
                    : actions with { Style = style, Depth = style == CnActionIconStyle.Natural };
                <button type="button" aria-pressed="@Pressed(actions.Style == style)"
                        @onclick="() => ActionValueChanged.InvokeAsync(preview)">
                    <CascadingValue Value="preview">
                        <span class="cn-icon-action-sample" aria-hidden="true">
                            <CnIcon Kind="CnIconKind.Edit" Role="CnIconRole.Action" />
                            <CnIcon Kind="CnIconKind.Delete" Role="CnIconRole.Action" />
                        </span>
                    </CascadingValue>
                    <span>@ActionLabel(style)</span>
                </button>
            }
        </div>
        <CnCheckbox Value="@(actions.SupportsDepth && actions.Depth)" Disabled="@(!actions.SupportsDepth)"
                    ValueChanged="depth => ActionValueChanged.InvokeAsync(actions with { Depth = depth })"
                    Label="@CnLabels.IconSubtleDepth" />
        <CnCheckbox Value="actions.DestructiveColor"
                    ValueChanged="red => ActionValueChanged.InvokeAsync(actions with { DestructiveColor = red })"
                    Label="@CnLabels.IconDestructiveColor" />
    }
</div>

@code {
    [Parameter] public CnIconAppearance Value { get; set; } = new(CnIconStyle.Natural);
    [Parameter] public EventCallback<CnIconAppearance> ValueChanged { get; set; }
    [Parameter] public CnActionIconAppearance? ActionValue { get; set; }
    [Parameter] public EventCallback<CnActionIconAppearance> ActionValueChanged { get; set; }

    private static readonly CnIconFamily[] Families = [CnIconFamily.Natural, CnIconFamily.Porcelain, CnIconFamily.Line];

    // Outline is not offered here; a host passing it starts from the Natural drawing.
    private CnIconStyle Selected => Value.Style.Family() == CnIconFamily.Outline ? CnIconStyle.Natural : Value.Style;

    private Task Change(CnIconAppearance value) => ValueChanged.InvokeAsync(value);
    private static string FamilyLabel(CnIconFamily family) => family switch
    {
        CnIconFamily.Porcelain => CnLabels.IconPorcelain,
        CnIconFamily.Line => CnLabels.IconLine,
        _ => CnLabels.IconNaturalColors,
    };
    private static string Pressed(bool selected) => selected ? "true" : "false";
    private static string ActionLabel(CnActionIconStyle style) => style switch
    {
        CnActionIconStyle.Functional => CnLabels.IconFunctional,
        CnActionIconStyle.Colored => CnLabels.IconColored,
        CnActionIconStyle.Natural => CnLabels.IconNaturalMaterials,
        _ => CnLabels.IconMonochrome,
    };
}
