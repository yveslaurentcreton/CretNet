@* A thin indeterminate bar while a screen fetches, then the content. The
   bar is the whole signal: a page on its way is not an event, and nothing
   should pull the eye to it. *@

@if (IsLoading)
{
    <div class="cn-loading" role="progressbar" aria-busy="true" aria-label="@AriaLabel">
        <span class="cn-loading-bar"></span>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public bool IsLoading { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    #pragma warning disable BL0007 // Pure resource fallback stays culture-aware; explicit parameter values remain unchanged.
    [Parameter] public string AriaLabel { get => field ?? CnLabels.Loading; set; } = null!;
    #pragma warning restore BL0007
}
