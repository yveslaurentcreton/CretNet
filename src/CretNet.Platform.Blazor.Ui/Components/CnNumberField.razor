@inherits CnInputBase<decimal?>

@* A number with an optional unit inside the field. A text input, not a
   number input: no spinners, and it reads a Belgian comma the way the
   currency field does. Commits on change. *@

<label class="cn-field @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="cn-label">@Label</span>
    }
    <span class="cn-money">
        <input type="text"
               inputmode="decimal"
               class="cn-input cn-input--right @UnitClass @SubtleClass @InvalidClass"
               value="@Text"
               placeholder="@Placeholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               aria-label="@(Label ?? AriaLabel)"
               @onchange="OnChangeAsync"
               @attributes="AdditionalAttributes" />
        @if (!string.IsNullOrEmpty(Unit))
        {
            <span class="cn-money-unit" aria-hidden="true">@Unit</span>
        }
    </span>
    @foreach (var message in ValidationMessages)
    {
        <span class="cn-field-error">@message</span>
    }
</label>
