@inherits CnInputBase<Guid?>
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@* Generic combobox picker (HCMT's S-084 CnPicker v2): a real text input you
   type into directly. Typeahead debounces into the Provider and shows a
   dropdown; arrows + Enter select, Escape/blur revert to the committed
   label. An optional AdvancedSearch callback adds a magnifier that awaits
   the wrapper's own search flow. Every path that sets Value routes through
   SetSelectionAsync so the visible label always tracks the selection. The
   *Select wrappers in the app supply Provider (and optionally OnAdd or
   AdvancedSearch) and keep their own public parameter surface. *@

<div class="cn-field cn-picker @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="cn-label" for="@_inputId">@Label</label>
    }
    <div class="cn-picker-field">
        <div @ref="_anchorRef" class="cn-picker-inputwrap cn-input @SubtleClass @InvalidClass @(_open ? "cn-picker-inputwrap--open" : null) @(Disabled ? "cn-picker-inputwrap--disabled" : null) @(ReadOnly ? "cn-picker-inputwrap--readonly" : null)">
            <input id="@_inputId"
                   type="text"
                   class="cn-picker-input"
                   value="@_text"
                   placeholder="@(Placeholder ?? "Select…")"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   autocomplete="off"
                   role="combobox"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="@($"{_inputId}-list")"
                   aria-activedescendant="@(_open && _activeIndex >= 0 ? $"{_inputId}-opt-{_activeIndex}" : null)"
                   @oninput="OnInputAsync"
                   @onfocus="OnFocusAsync"
                   @onclick="OnFocusAsync"
                   @onblur="OnBlurAsync"
                   @onkeydown="OnKeyDownAsync"
                   @onkeydown:preventDefault="SuppressDefault"
                   @attributes="AdditionalAttributes" />
            @if (!ReadOnly && !Disabled)
            {
                <div class="cn-picker-actions">
                    @if (Value is not null)
                    {
                        <button type="button" class="cn-picker-btn" tabindex="-1" title="Clear"
                                @onmousedown:preventDefault @onclick="ClearAsync">
                            <CnIcon Kind="CnIconKind.Dismiss"/>
                        </button>
                    }
                    @if (AdvancedSearch is not null)
                    {
                        <button type="button" class="cn-picker-btn" tabindex="-1" title="Search"
                                @onmousedown:preventDefault @onclick="OpenAdvancedAsync">
                            <CnIcon Kind="CnIconKind.Search"/>
                        </button>
                    }
                </div>
            }
        </div>
        @if (_open && !ReadOnly && !Disabled)
        {
            <div @ref="_dropdownRef"
                 class="cn-picker-dropdown"
                 @onclick:stopPropagation
                 @onmousedown:preventDefault>
                <ul class="cn-picker-list" id="@($"{_inputId}-list")" role="listbox">
                    @if (!_loading && _results.Count == 0)
                    {
                        <li class="cn-picker-empty">@NothingFoundLabel</li>
                    }
                    @for (var i = 0; i < _results.Count; i++)
                    {
                        var index = i;
                        var item = _results[index];
                        @if (_grouped && index == 0)
                        {
                            <li class="cn-picker-group">@RecentGroupLabel</li>
                        }
                        else if (_grouped && index == _firstNonRecentIndex)
                        {
                            <li class="cn-picker-group">@AllGroupLabel</li>
                        }
                        <li class="cn-picker-option @(index == _activeIndex ? "cn-picker-option--active" : null) @(item.Id == Value ? "cn-picker-option--selected" : null)"
                            id="@($"{_inputId}-opt-{index}")"
                            role="option"
                            aria-selected="@(item.Id == Value ? "true" : "false")"
                            @onclick="() => SelectAsync(item)"
                            @onmouseover="() => _activeIndex = index">
                            @if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                <span class="cn-picker-option-main">
                                    <span class="cn-picker-option-title">@item.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Context))
                                    {
                                        <span class="cn-picker-option-context">@item.Context</span>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.Meta))
                                {
                                    <span class="cn-badge @(item.MetaAccent ? "cn-badge--accent" : null) cn-picker-option-meta">@item.Meta</span>
                                }
                            }
                        </li>
                    }
                </ul>
                @if (AdvancedSearch is not null || OnAdd is not null)
                {
                    <div class="cn-picker-foot">
                        @if (AdvancedSearch is not null)
                        {
                            <button type="button" class="cn-picker-foot-btn" tabindex="-1"
                                    @onmousedown:preventDefault @onclick="OpenAdvancedAsync">
                                <CnIcon Kind="CnIconKind.Search"/>@AdvancedSearchLabel
                            </button>
                        }
                        @if (OnAdd is not null)
                        {
                            <button type="button" class="cn-picker-foot-btn" tabindex="-1"
                                    @onmousedown:preventDefault @onclick="OpenAddAsync">
                                <CnIcon Kind="CnIconKind.Add"/>@AddLabel
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
    @foreach (var message in ValidationMessages)
    {
        <span class="cn-field-error">@message</span>
    }
</div>

@code {
    /// <summary>Search-as-you-type fetcher; null/empty search returns the default (top) page.</summary>
    [Parameter, EditorRequired] public Func<string?, Task<IReadOnlyList<CnPickerItem>>> Provider { get; set; } = default!;

    /// <summary>Resolves the display label for a Value that isn't in the current result page (e.g. deep-linked ids).</summary>
    [Parameter] public Func<Guid, Task<string?>>? ResolveLabel { get; set; }

    /// <summary>
    /// Optional advanced grid-search: when set, a magnifier appears next to the
    /// field and awaits this callback (the wrapper opens its own search
    /// dialog). Returning a non-null item selects it. When null the magnifier
    /// is hidden and typeahead is the only search path.
    /// </summary>
    [Parameter] public Func<Task<CnPickerItem?>>? AdvancedSearch { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Optional custom row template. The default row renders the item's Label
    /// with an optional Context line underneath and an optional Meta badge on
    /// the right; absent context renders nothing.
    /// </summary>
    [Parameter] public RenderFragment<CnPickerItem>? ItemTemplate { get; set; }

    /// <summary>
    /// Optional quick-create: when set, the dropdown footer shows an add
    /// button that awaits this callback (the wrapper opens its own create
    /// flow). Returning a non-null item selects it immediately.
    /// </summary>
    [Parameter] public Func<Task<CnPickerItem?>>? OnAdd { get; set; }

    // Chrome strings as parameters with English defaults — the RCL carries
    // no resource dependency; hosts localise by passing their own labels.
    [Parameter] public string AddLabel { get; set; } = "New…";
    [Parameter] public string NothingFoundLabel { get; set; } = "Nothing found";
    [Parameter] public string RecentGroupLabel { get; set; } = "Recent";
    [Parameter] public string AllGroupLabel { get; set; } = "All";
    [Parameter] public string AdvancedSearchLabel { get; set; } = "Advanced search…";

    private const int MaxResults = 15;
    private readonly string _inputId = $"cn-picker-{Guid.NewGuid():N}";

    private ElementReference _anchorRef;
    private ElementReference _dropdownRef;
    private IJSObjectReference? _module;

    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    // While open, pin the dropdown to the field with position: fixed so overflow
    // ancestors (dialog bodies scroll) can never clip it — see CnPicker.razor.js.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open)
            return;

        try
        {
            _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/CretNet.Platform.Blazor.Ui/Components/CnPicker.razor.js");
            await _module.InvokeVoidAsync("place", _dropdownRef, _anchorRef);
        }
        catch (JSDisconnectedException)
        {
            // circuit/page tear-down; nothing to place
        }
        catch (JSException jsException)
        {
            // Never let a placement failure break the picker itself — the dropdown
            // falls back to its absolute CSS position. Log so it is diagnosable.
            Console.Error.WriteLine($"CnPicker dropdown placement failed: {jsException.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private bool _open;
    private bool _loading;
    private string _text = string.Empty;
    private string? _label;
    private int _activeIndex = -1;
    private Guid? _lastResolvedValue;
    private List<CnPickerItem> _results = [];
    private CancellationTokenSource? _searchDebounce;

    // Prevent the browser default only while a highlighted option is armed, so
    // Enter selects (and never submits an enclosing EditForm) and the arrow keys
    // don't move the caret. When nothing is highlighted the input types freely.
    private bool SuppressDefault => _open && _activeIndex >= 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Value == _lastResolvedValue)
            return;

        _lastResolvedValue = Value;

        if (Value is null)
        {
            _label = null;
            _text = string.Empty;
            return;
        }

        var match = _results.FirstOrDefault(r => r.Id == Value);
        var label = match?.Label ?? (ResolveLabel is not null ? await ResolveLabel(Value.Value) : null);
        ApplyLabel(Value, label);
    }

    // Single place the committed label + visible text are refreshed for a value.
    private void ApplyLabel(Guid? id, string? label)
    {
        _lastResolvedValue = id;
        _label = label;
        _text = label ?? string.Empty;
    }

    // Single path every value-setting flow goes through (typeahead pick, dialog
    // pick, clear): refresh the label AND push the new Value out.
    private async Task SetSelectionAsync(Guid? id, string? label)
    {
        ApplyLabel(id, label);
        _activeIndex = -1;
        await SetValueAsync(id);
    }

    private async Task OnFocusAsync()
    {
        if (ReadOnly || Disabled || _open)
            return;

        _open = true;
        _activeIndex = -1;
        // With a committed selection the visible text is the chosen label; searching
        // on it would just echo the current value back as the only result. Open with
        // the default top page instead so something ELSE can be picked immediately;
        // typing still narrows as usual.
        var searchText = Value is not null ? null : (string.IsNullOrWhiteSpace(_text) ? null : _text);
        await LoadResultsAsync(searchText);
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;
        _open = true;
        _activeIndex = -1;

        _searchDebounce?.Cancel();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;

        try
        {
            await Task.Delay(250, token);
            await LoadResultsAsync(string.IsNullOrWhiteSpace(_text) ? null : _text);
        }
        catch (TaskCanceledException)
        {
            // superseded by newer input
        }
    }

    private Task OnBlurAsync() => CloseAndRevertAsync();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (ReadOnly || Disabled)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                if (!_open)
                {
                    await OnFocusAsync();
                }
                else if (_results.Count > 0)
                {
                    _activeIndex = Math.Min(_activeIndex + 1, _results.Count - 1);
                }
                break;
            case "ArrowUp":
                if (_open && _results.Count > 0)
                    _activeIndex = Math.Max(_activeIndex - 1, 0);
                break;
            case "Enter":
                if (_open && _activeIndex >= 0 && _activeIndex < _results.Count)
                    await SelectAsync(_results[_activeIndex]);
                break;
            case "Escape":
                await CloseAndRevertAsync();
                break;
            default:
                // Any other key is normal typing: disarm so SuppressDefault
                // stops blocking character input on the next render.
                _activeIndex = -1;
                break;
        }
    }

    private async Task SelectAsync(CnPickerItem item)
    {
        _open = false;
        _searchDebounce?.Cancel();
        await SetSelectionAsync(item.Id, item.Label);
    }

    private async Task ClearAsync()
    {
        _open = false;
        _searchDebounce?.Cancel();
        await SetSelectionAsync(null, null);
    }

    private async Task OpenAdvancedAsync()
    {
        if (AdvancedSearch is null)
            return;

        _open = false;
        _searchDebounce?.Cancel();

        var picked = await AdvancedSearch();
        if (picked is not null)
            await SetSelectionAsync(picked.Id, picked.Label);
    }

    // Quick-create from the dropdown footer — same contract as the advanced
    // search: the wrapper runs its create flow and the returned item becomes
    // the selection.
    private async Task OpenAddAsync()
    {
        if (OnAdd is null)
            return;

        _open = false;
        _searchDebounce?.Cancel();

        var created = await OnAdd();
        if (created is not null)
            await SetSelectionAsync(created.Id, created.Label);
    }

    private Task CloseAndRevertAsync()
    {
        _open = false;
        _activeIndex = -1;
        _searchDebounce?.Cancel();
        // Drop any half-typed free text: snap back to the committed label.
        _text = _label ?? string.Empty;
        return Task.CompletedTask;
    }

    private bool _grouped;
    private int _firstNonRecentIndex = -1;

    private async Task LoadResultsAsync(string? search)
    {
        _loading = true;
        StateHasChanged();

        var results = await Provider(search);
        var page = results.Take(MaxResults).ToList();

        // With an empty query the provider may flag derived-recent items;
        // show those first under "Recent" with the rest under "All". A typed
        // search never groups.
        _grouped = search is null && page.Any(r => r.Recent) && page.Any(r => !r.Recent);
        if (_grouped)
        {
            page = page.OrderByDescending(r => r.Recent).ToList();
            _firstNonRecentIndex = page.FindIndex(r => !r.Recent);
        }
        else
        {
            _firstNonRecentIndex = -1;
        }

        _results = page;
        _loading = false;
        StateHasChanged();
    }
}
