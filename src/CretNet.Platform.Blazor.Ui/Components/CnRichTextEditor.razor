
<div class="rte">
    <div class="rte-toolbar @(ReadOnly ? "rte-hidden" : null)" @ref="_toolbarElement" role="toolbar">
        <button type="button" class="rte-btn" data-cmd="bold" title="@CnLabels.Bold" aria-label="@CnLabels.Bold"><b>B</b></button>
        <button type="button" class="rte-btn" data-cmd="italic" title="@CnLabels.Italic" aria-label="@CnLabels.Italic"><i>I</i></button>
        <button type="button" class="rte-btn" data-cmd="underline" title="@CnLabels.Underline" aria-label="@CnLabels.Underline"><u>U</u></button>
        <span class="rte-sep"></span>
        <button type="button" class="rte-btn" data-cmd="h3" title="@CnLabels.Subtitle" aria-label="@CnLabels.Subtitle">@CnLabels.SubtitleShort</button>
        <span class="rte-sep"></span>
        <button type="button" class="rte-btn" data-cmd="insertUnorderedList" title="@CnLabels.BulletList" aria-label="@CnLabels.BulletList">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="4" r="1.1" fill="currentColor"/><circle cx="3" cy="8" r="1.1" fill="currentColor"/><circle cx="3" cy="12" r="1.1" fill="currentColor"/><path d="M6.5 4h7M6.5 8h7M6.5 12h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="rte-btn" data-cmd="insertOrderedList" title="@CnLabels.NumberedList" aria-label="@CnLabels.NumberedList">
            <svg viewBox="0 0 16 16" aria-hidden="true"><text x="1" y="6" font-size="5.5" font-weight="700" fill="currentColor">1</text><text x="1" y="14" font-size="5.5" font-weight="700" fill="currentColor">2</text><path d="M6.5 4h7M6.5 12h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </button>
        <span class="rte-sep"></span>
        <button type="button" class="rte-btn" data-cmd="removeFormat" title="@CnLabels.ClearFormatting" aria-label="@CnLabels.ClearFormatting">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h8M7.2 3 5.5 13M9 13H4.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M11 9.5l3.5 3.5M14.5 9.5 11 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </button>
    </div>
    <div class="rte-editor @(ReadOnly ? "rte-editor-readonly" : null)" @ref="_editorElement"></div>
</div>
