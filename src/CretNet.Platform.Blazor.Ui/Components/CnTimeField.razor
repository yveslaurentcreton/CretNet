@inherits CnInputBase<TimeOnly?>

@* One time of day: a field you can type into (see CnTimeMask) with a clock
   dial hanging under it. Seconds are a parameter — mask, typing and dial all
   follow it. *@

<div class="cn-field cn-date @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="cn-label">@Label</span>
    }
    <div class="cn-date-anchor" @ref="_anchorRef">
        <div class="cn-date-shell cn-input @SubtleClass @InvalidClass @(_open ? "cn-date-shell--open" : null) @(Disabled ? "cn-date-shell--disabled" : null)"
             @onclick="Open">
            <svg class="cn-date-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                <path d="M8 5v3.2l2.2 1.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <CnTimeInput @ref="_input"
                         Value="Value"
                         ValueChanged="OnValueChangedAsync"
                         Seconds="Seconds"
                         AriaLabel="@(Label ?? AriaLabel)"
                         ReadOnly="ReadOnly"
                         Disabled="Disabled"
                         OnFocused="OnFieldFocused"
                         OnBlurred="OnFieldBlurredAsync"
                         OnEnter="Close"
                         OnEscape="RevertAsync" />
            @if (Value is not null && !ReadOnly && !Disabled)
            {
                <button type="button" class="cn-date-clear" title="@ClearLabel" aria-label="@ClearLabel"
                        @onmousedown:preventDefault @onclick="ClearAsync" @onclick:stopPropagation>
                    <CnIcon Kind="CnIconKind.Dismiss" />
                </button>
            }
        </div>

        @if (_open && !ReadOnly && !Disabled)
        {
            @* The mouse must not move focus out of the field: a blur would run
               the completion and write the old text back over the dial's pick. *@
            <div class="cn-date-pop" role="dialog" @ref="_popRef" @onmousedown:preventDefault aria-label="@Label">
                <CnClockPanel @ref="_clock"
                              Value="Value ?? DefaultTime"
                              ValueChanged="OnDialledAsync"
                              Seconds="Seconds"
                              OnDone="OnDialDoneAsync"
                              HourHint="@HourHint"
                              MinuteHint="@MinuteHint"
                              SecondHint="@SecondHint">
                    <FooterActions>
                        <button type="button" class="cn-cal-action" @onclick="NowAsync">@NowLabel</button>
                    </FooterActions>
                </CnClockPanel>
            </div>
        }
    </div>
    @foreach (var message in ValidationMessages)
    {
        <span class="cn-field-error">@message</span>
    }
</div>
