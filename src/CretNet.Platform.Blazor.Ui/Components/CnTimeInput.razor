@using Microsoft.AspNetCore.Components.Web

@* The typable half of a time field: one masked input, no chrome. Used on its
   own by CnTimeField and beside a date by CnDateTimeField, so the typing
   rules live in exactly one place. See CnTimeMask for those rules. *@

<input @ref="Element"
       type="text"
       class="cn-date-input @(Seconds ? "cn-time-input--seconds" : "cn-time-input") @Class"
       style="@Style"
       value="@_text"
       placeholder="@(Placeholder ?? (Seconds ? "hh:mm:ss" : "hh:mm"))"
       readonly="@ReadOnly"
       disabled="@Disabled"
       inputmode="numeric"
       autocomplete="off"
       spellcheck="false"
       aria-label="@AriaLabel"
       @oninput="OnInputAsync"
       @onblur="OnBlurAsync"
       @onfocus="OnFocusAsync"
       @onkeydown="OnKeyDownAsync"
       @attributes="AdditionalAttributes" />
