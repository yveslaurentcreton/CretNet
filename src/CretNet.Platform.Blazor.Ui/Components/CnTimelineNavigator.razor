@* The bar above a scrollable CnTimeline: the months in view, ‹ Vandaag ›
   and the zoom. Its own component so that what scrolling reports (the
   range, the ends) re-renders this bar and not the whole timeline. *@

<div class="cn-gantt-tools">
    <span class="cn-gantt-range" aria-live="polite">@RangeText</span>
    <div class="cn-gantt-ctl">
        <button type="button" class="cn-gantt-btn" data-cn-gantt-go="-1"
                title="@CnLabels.Earlier" aria-label="@CnLabels.Earlier"
                disabled="@View.AtStart" @onclick="() => OnGo.InvokeAsync(-1)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" class="cn-gantt-btn" data-cn-gantt-go="0"
                @onclick="() => OnGo.InvokeAsync(0)">@CnLabels.Today</button>
        <button type="button" class="cn-gantt-btn" data-cn-gantt-go="1"
                title="@CnLabels.Later" aria-label="@CnLabels.Later"
                disabled="@View.AtEnd" @onclick="() => OnGo.InvokeAsync(1)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
        <CnViewSwitch TValue="int"
                      Value="Zoom"
                      ValueChanged="OnZoom"
                      Options="Zooms"
                      OptionText="ZoomText"
                      AriaLabel="@CnLabels.Zoom"
                      Class="cn-gantt-zoom" />
    </div>
</div>
