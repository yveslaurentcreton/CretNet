@inherits CnpComponent
@typeparam TItem where TItem : CretNet.Platform.Querying.IPickerItem<TId>
@typeparam TId where TId : struct
@using System.Linq.Expressions
@using CretNet.Platform.Querying

<div style="flex-grow: 1;">
    <FluentAutocomplete TOption="TItem"
                        Label="@Label"
                        Placeholder="@Placeholder"
                        OptionText="x => x.DisplayLabel"
                        OptionValue="x => x.Id.ToString()"
                        OnOptionsSearch="OnOptionsSearchAsync"
                        MaximumOptionsSearch="MaximumResults"
                        MaximumSelectedOptions="1"
                        SelectedOptions="_selectedOptions"
                        SelectedOptionsChanged="OnSelectedOptionsChangedAsync"
                        ShowOverflow="false"
                        Disabled="Disabled || ReadOnly"
                        Required="Required" />

    @if (For is not null)
    {
        <FluentValidationMessage For="@For" />
    }
</div>
